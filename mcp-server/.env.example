# -----------------------------------------------------------------------
# JuiceBox MCP Server — environment variables
# Copy this file to .env and fill in values for your setup.
# -----------------------------------------------------------------------

# Port the HTTP/SSE server listens on inside the container (and on the host
# when running via docker-compose — both sides use the same value).
PORT=3001

# MQTT broker URL. When running via docker-compose this should point at the
# Mosquitto container. When running locally, use mqtt://localhost:1883.
MQTT_BROKER=mqtt://localhost:1883

# Optional: MQTT broker credentials (leave blank if broker has no auth).
#MQTT_USER=
#MQTT_PASS=

# Optional: timezone for charging schedule windows (default: America/Phoenix).
# Use any IANA timezone name, e.g. America/Los_Angeles, America/New_York.
#TZ_OVERRIDE=America/Phoenix

# Optional: log verbosity. "error" (errors only), "info" (default), "debug" (verbose).
#LOG_LEVEL=info

# Required for the ZentriOS tools (get_diagnostics, get_wifi_info, wifi_scan,
# reboot_charger). This is the charger's LAN IP — zentriosClient.js calls
# http://$JUICEBOX_HOST/command/<cmd>. MQTT telemetry does NOT depend on this,
# so if it is wrong or missing, status/start/stop keep working while every
# ZentriOS call times out. Must match JUICEBOX_HOST in the root .env.
JUICEBOX_HOST=<YOUR-JUICEBOX-IP>

# Optional: ZentriOS HTTP API timeout in milliseconds (default: 5000).
# Increase if the charger WiFi is flaky and you see spurious timeouts.
#ZENTRIOS_TIMEOUT=5000
